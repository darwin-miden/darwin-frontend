# backup_write — network note that persists an encrypted account-file backup
# into a NETWORK controller's slot-10 StorageMap, 24 chunk-Words per note.
#
# GENERATED by scratchpad/gen_backup_note.mjs — do not hand-edit; regenerate.
#
# The browser encrypts + gzips the account file, packs it into 28-byte Words,
# pads to a multiple of 24, and emits one of these notes per 24-word batch.
# The NTB consumes each note and applies the 24 set_user_position writes to the
# network controller (no Mac relay, no signing key). Recovery reads the chunks
# back off-chain (backup_read), decrypts, and importAccountFile.
#
# Input layout (get_storage → mem[100..]): see gen_backup_note.mjs.
# set_user_position MAST is stable across v6/v7/v8/network controllers.

