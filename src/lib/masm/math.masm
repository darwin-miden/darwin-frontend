# Felt-scale math helpers used by the Darwin Protocol Account.
#
# Spec: darwin-docs/architecture-spec.md §6.2 (NAV precision).
#
# The other library modules (mint, fees, redeem, nav, flow) use
# `u32div` for their final integer division. That op requires both
# operands to fit in u32, which is restrictive for real on-chain
# values. This module provides `felt_div`, a u64-safe division that
# wraps the std-lib `miden::core::math::u64::div` procedure.
#
# `felt_div` accepts any two felt values whose magnitudes fit in u64
# (the Goldilocks felt comfortably represents anything up to
# ~1.84e19), splits each into a (lo, hi) u32 pair, calls the std-lib
# divider, and recombines the (lo, hi) result back into a felt. The
# round-trip is exact when both operands and the quotient fit in u64.

use miden::core::math::u64

const TWO_POW_32 = 4294967296

#! Computes `num / div` as integer division, with both inputs and the
#! quotient treated as u64 values represented as felts.
#!
#! Stack on entry:   [num, div]
#! Stack on exit:    [num / div]
#!
#! The numerator and divisor must each fit in u64 (i.e. their felt
#! values must be < 2^64). Within Darwin's spec scales (USD * 1e8,
#! basket-token base units at 8 decimals, etc.) this constraint is
#! comfortably satisfied for any plausible TVL.
pub proc felt_div
    # Stack: [num, div]
    u32split             # [num_lo, num_hi, div]
    movup.2              # [div, num_lo, num_hi]
    u32split             # [div_lo, div_hi, num_lo, num_hi]
    exec.u64::div        # [result_lo, result_hi]
    # Recombine: result = result_lo + result_hi * 2^32
    swap                 # [result_hi, result_lo]
    push.TWO_POW_32      # [2^32, result_hi, result_lo]
    mul                  # [result_hi * 2^32, result_lo]
    add                  # [result]
end

#! Computes `a * b / div` as integer division WITHOUT the field-overflow that a
#! plain `mul` + `felt_div` suffers.
#!
#! Stack on entry:   [div, b, a]        (div on top, then b, then a)
#! Stack on exit:    [a * b / div]
#!
#! `felt_div` is u64-safe for its *operands*, but the NAV math forms the PRODUCT
#! `a * b` first (e.g. net * S, or s * V). A Goldilocks `mul` reduces mod p
#! (≈ 1.845e19), so once a*b exceeds p — which happens for any real basket
#! (net*S ≈ TVL$ × trade$ × 1e16, overflowing at TVL$×trade$ ≳ 1845) — the product
#! wraps and the subsequent division yields silently-wrong, grindably over-minted
#! shares. This proc instead:
#!   1. forms the EXACT 128-bit product via std-lib `u64::widening_mul`,
#!   2. REVERTS if that product does not fit u64 (bits 64..127 non-zero) — a safe
#!      revert of an out-of-range trade, never a silent over-mint,
#!   3. divides the wide product by `div` through `u64::div` on the raw limbs, so
#!      the product is never recombined into a wrap-prone felt.
#!
#! The result `a*b/div` is assumed to fit a felt (it is a bounded shares/payout
#! value in Darwin's spec scales); the caller's downstream asserts still apply.
pub proc mul_div
    # Stack: [div, b, a]
    movup.2              # [a, div, b]
    u32split             # [a_lo, a_hi, div, b]
    movup.3              # [b, a_lo, a_hi, div]
    u32split             # [b_lo, b_hi, a_lo, a_hi, div]
    exec.u64::widening_mul
    # [p0, p1, p2, p3, div]  where a*b = p0 + p1·2^32 + p2·2^64 + p3·2^96
    movup.3              # [p3, p0, p1, p2, div]
    assertz.err="mul_div: product exceeds u64 (trade too large for this basket)"
    movup.2              # [p2, p0, p1, div]
    assertz.err="mul_div: product exceeds u64 (trade too large for this basket)"
    # [p0, p1, div]  = [prod_lo, prod_hi, div], product < 2^64
    movup.2              # [div, prod_lo, prod_hi]
    u32split             # [div_lo, div_hi, prod_lo, prod_hi]
    exec.u64::div        # [q_lo, q_hi]  = (prod / div)
    swap                 # [q_hi, q_lo]
    push.TWO_POW_32      # [2^32, q_hi, q_lo]
    mul                  # [q_hi·2^32, q_lo]
    add                  # [a*b/div]
end
